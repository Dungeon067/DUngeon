{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tinh Tu Uoc Nguyen",
  "version": "0.1.0",
  "identifier": "vn.tinhtu.uocnguyen",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Tinh Tú Ước Nguyện",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0f1430"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Tinh Tú",
    "shortDescription": "Tinh Tú Ước Nguyện",
    "longDescription": "Game nhập vai hành động 2D thế giới mở lấy cảm hứng từ thần thoại Việt Nam.",
    "category": "RolePlayingGame",
    "copyright": "Tinh Tú",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": ["English"]
      }
    }
  }
}
