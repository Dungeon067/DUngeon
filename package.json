{
  "name": "tinh-tu-uoc-nguyen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').cpSync('legacy','dist/legacy',{recursive:true})\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/content-check.ts",
    "economy:sim": "tsx tools/economy/main.ts",
    "admin:hash": "tsx scripts/admin-hash.ts",
    "fps": "tsx tests/perf/fps.ts",
    "record": "tsx tests/perf/record.ts",
    "icons": "tsx scripts/icons.ts",
    "cap:sync": "pnpm build && cap sync",
    "android:apk": "pnpm cap:sync && cd android && ./gradlew assembleRelease",
    "tauri": "tauri",
    "sprites": "tsx tools/sprites/build.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^7",
    "@eslint/js": "^9",
    "@playwright/test": "1.49.1",
    "@resvg/resvg-js": "^2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/three": "0.170.0",
    "eslint": "^9",
    "globals": "^15",
    "jsdom": "^25",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "~5.6",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vite-plugin-pwa": "^0.21",
    "vitest": "^3.2.7",
    "workbox-window": "^7"
  },
  "dependencies": {
    "@capacitor/android": "^7",
    "@capacitor/core": "^7",
    "@capacitor/ios": "^7",
    "three": "0.170.0",
    "yaml": "^2",
    "zod": "^3"
  }
}
