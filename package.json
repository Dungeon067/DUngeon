{
  "name": "tinh-tu-uoc-nguyen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').cpSync('legacy','dist/legacy',{recursive:true})\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/content-check.ts",
    "fps": "tsx tests/perf/fps.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "1.49.1",
    "@types/node": "^22",
    "eslint": "^9",
    "globals": "^15",
    "jsdom": "^25",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "~5.6",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "yaml": "^2",
    "zod": "^3"
  }
}
